# Copy to .env for local development: cp .env.example .env
# .env is gitignored. Never commit real keys.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5487/launchpad

# Port 5000 is taken by macOS AirPlay Receiver, so use another one locally.
PORT=5055

SESSION_SECRET=change-me-to-a-long-random-string

# Replit login only works on Replit. These placeholders let the server boot;
# use email/password login locally.
REPLIT_DOMAINS=localhost
REPL_ID=local-dev

# The server refuses to start without a key. A placeholder works, but AI Coach
# replies will fail until you set a real key.
OPENAI_API_KEY=sk-placeholder

# Emails that get the administrator role on Replit login (comma-separated).
SUPER_ADMIN_EMAILS=
