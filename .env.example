# Copy to .env for local development: cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Database -------------------------------------------------------------
# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5487/launchpad
# disable (local) | require (Supabase pooler) | verify
DATABASE_SSL=disable
# Max pooled connections. Use 3 on Vercel.
DB_POOL_MAX=10

# --- App --------------------------------------------------------------------
# Port 5000 is taken by macOS AirPlay Receiver, so use another one locally.
PORT=5055
SESSION_SECRET=change-me-to-a-long-random-string
# Used in password reset and invite links. Defaults to http://localhost:$PORT,
# or the Vercel production URL when deployed.
APP_BASE_URL=http://localhost:5055

# --- File storage (Supabase Storage) ----------------------------------------
# Leave empty locally to disable uploads (the API answers 503).
SUPABASE_URL=
# Use the legacy service_role JWT; the newer sb_secret_ keys are rejected by
# signed upload URLs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Email (Resend) ---------------------------------------------------------
# Without a key, emails (reset and invite links) are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=MD Genius Launchpad <no-reply@mdgeniusai.com>

# --- AI Coach (OpenAI) ------------------------------------------------------
# Without a key, the AI Coach answers 503 "not configured".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
